<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- FocusFlow is offline-first: no INTERNET permission. -->

    <!-- Session alerts (runtime permission on Android 13+; the timer works without it). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The session-end alarm must be exact: an inexact alarm may be deferred by up to 75 % of the
         time until it is due (18 minutes for a 25 minute session), even while the phone is in use.
         FocusFlow is a timer, which Google Play's policy allows to use USE_EXACT_ALARM; it is
         granted at install on Android 13+. Android 12/12L use SCHEDULE_EXACT_ALARM, granted by
         default there but revocable by the user (FocusFlow then falls back to an inexact alarm). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Restores the deadline alarm after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".FocusFlowApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.FocusFlow"
        tools:targetApi="tiramisu">

        <profileable android:shell="true" tools:targetApi="q" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FocusFlow.Starting"
            android:configChanges="screenSize|smallestScreenSize|orientation|screenLayout|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands a statistics image to the app the user picks in the share sheet. Not exported:
             access is granted per share, read-only, to that app only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!-- Deadline alarm and notification buttons; only FocusFlow itself can send these. -->
        <receiver
            android:name=".platform.TimerActionReceiver"
            android:exported="false" />

        <!-- Protected system broadcasts only (boot, app update, exact-alarm permission change). -->
        <receiver
            android:name=".platform.TimerRestoreReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
